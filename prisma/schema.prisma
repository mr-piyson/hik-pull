// Device configuration, master users, access events, and user sync history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Device {
  id        String   @id
  label     String
  /// "http" | "https" — SQLite has no enums, so validated in code.
  scheme    String   @default("http")
  host      String
  port      Int      @default(80)
  username  String
  /// Plaintext, same as it always was in `.data/devices.json`. The app runs on
  /// a LAN with no users or TLS, so this is not a downgrade. Never returned by
  /// any API — see `toPublicDevice`.
  password  String   @default("")
  createdAt String

  deviceModel  String?
  deviceSerial String?

  events LogEvent[]
  syncLogs UserSyncLog[]

  @@index([host])
}

/// One access-control event. `deviceId + id` is the identity: `id` is stable
/// for a given event on a given device but only unique within that device.
model LogEvent {
  /// The device's stable event id (serial number, or a time/card derived key).
  id       String
  deviceId String

  /// Device-reported timestamp, kept verbatim (including its timezone offset)
  /// so what is shown is exactly what the terminal said. Display only.
  time String?

  /// Epoch milliseconds parsed from `time`, used for range filters and
  /// ordering. The verbatim `time` string carries a local offset, so it cannot
  /// be compared against the UTC bounds the client sends. `null` when the
  /// device omitted a usable timestamp.
  timeMs BigInt?

  /// "in" | "denied" | "door" | "other"
  direction String
  /// Human label for the minor code, e.g. "fingerprint invalid".
  label String
  major Int
  minor Int

  name       String @default("")
  employeeNo String @default("")
  cardNo     String @default("")
  readerNo   Int?
  serialNo   String?

  /// "live" | "backfill"
  source String

  /// When *we* learned about it, for stable server-side ordering of events
  /// that share a device timestamp.
  receivedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, id])
  @@index([deviceId, timeMs])
  @@index([deviceId, direction])
  @@index([receivedAt])
}

/// Successful person-authentication events, retained independently of devices
/// and the general access-event log.
model AttendanceLog {
  id           String    @id
  deviceIp     String?   @map("device_ip")
  deviceModel  String?   @map("device_model")
  deviceSerial String?   @map("device_serial")
  serialNo     BigInt?   @map("serial_no")
  personId     String?   @map("person_id")
  personName   String?   @map("person_name")
  cardNo       String?   @map("card_no")
  dateTime     DateTime? @map("datetime")
  timeRaw      String?   @map("time_raw")

  /// Internal event identity prevents live-stream and history imports from
  /// storing the same terminal event twice.
  sourceKey String @unique @map("_source_key")

  @@index([dateTime])
  @@index([personId, dateTime])
  @@map("attendance_logs")
}

/// Master user records maintained by this application and synchronized to
/// each configured terminal. Date-time strings are local terminal times.
model User {
  id                  String   @id
  employeeNo          String   @unique
  name                String
  cardNo              String   @default("")
  cardNosJson         String   @default("[]")
  userType            String   @default("normal")
  floorNumber         Int      @default(0)
  roomNumber          Int      @default(0)
  gender              String   @default("unknown")
  longTermEffective   Boolean  @default(false)
  isAdministrator     Boolean  @default(false)
  visitTimes          Int      @default(0)
  authenticationType  String   @default("sameDevice")
  authenticationMode  String   @default("face")
  validFrom           String?
  validUntil          String?
  photoData  Bytes?
  photoMimeType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  syncLogs UserSyncLog[]

  @@index([name])
}

/// Immutable record of each user sync attempt, including deleted users.
model UserSyncLog {
  id          String   @id
  userId      String?
  employeeNo  String
  userName    String
  deviceId    String?
  deviceLabel String
  operation   String
  status      String
  message     String?
  createdAt   DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([employeeNo, createdAt])
}
