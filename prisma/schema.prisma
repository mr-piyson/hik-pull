// Device configuration, master users, access events, and user sync history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Device {
  id        String @id
  label     String
  /// "http" | "https" — SQLite has no enums, so validated in code.
  scheme    String @default("http")
  host      String
  port      Int    @default(80)
  username  String
  /// Plaintext, same as it always was in `.data/devices.json`. The app runs on
  /// a LAN with no users or TLS, so this is not a downgrade. Never returned by
  /// any API — see `toPublicDevice`.
  password  String @default("")
  createdAt String

  /// Role assigned to successful attendance events recorded at this terminal.
  gateDirection String @default("none")
  lastHistorySyncAt DateTime?
  deviceModel  String?
  deviceSerial String?

  /// Synchronization cursor: the highest event observed from this terminal.
  /// `lastHistorySyncAt` drives the query window; these record the exact point
  /// so progress is inspectable and late events are provably bounded by the
  /// stable event key. The Hikvision AcsEvent API itself only accepts time
  /// windows, so the window is the cursor and the key is the tie-breaker.
  lastEventTime DateTime?
  lastEventKey  String?
  /// Last collection failure for this terminal; cleared on the next success.
  lastSyncError String?
  /// Operational state: "online" | "offline" | "error" | "unknown".
  status        String @default("unknown")

  events         LogEvent[]
  syncLogs       UserSyncLog[]
  attendanceLogs AttendanceLog[]

  @@index([host])
}

/// Persistent singleton for operator-configurable collection and display
/// behavior. SQLite has no singleton constraints, so code uses the fixed id.
model AppSettings {
  id                       String  @id @default("global")
  autoStartLiveStreams     Boolean @default(true)
  historySyncEnabled       Boolean @default(true)
  historySyncIntervalHours Int     @default(24)
  historyStartupDelaySecs  Int     @default(60)
  historyLookbackHours     Int     @default(24)
  historyOverlapMinutes    Int     @default(5)
  historyBatchSize         Int     @default(500)
  reconnectBaseSeconds     Int     @default(1)
  reconnectMaxSeconds      Int     @default(30)
  attendanceRefreshSeconds Int     @default(10)
  facePhotoTargetKB        Int     @default(190)
  maxPhotoUploadMB         Int     @default(10)

  /// Worker control. The attendance worker is always running; these flags
  /// pause or resume its two independent jobs without restarting any process.
  hikvisionSyncEnabled Boolean @default(true)
  hikvisionIntervalSecs Int    @default(30)

  /// Local database -> AWS ingestion. `cloudApiToken` is server-side only and
  /// is never serialised to the browser, like device passwords.
  cloudSyncEnabled   Boolean @default(false)
  cloudIntervalSecs  Int     @default(60)
  cloudBatchSize     Int     @default(100)
  cloudRetryBaseSecs Int     @default(30)
  cloudMaxAttempts   Int     @default(10)
  cloudEndpoint      String  @default("")
  cloudApiToken      String  @default("")

  @@map("app_settings")
}

/// Singleton runtime status for the attendance worker, kept separate from the
/// operator-configurable `AppSettings`. Fixed id, like `AppSettings`.
model WorkerState {
  id                 String    @id @default("global")
  lastHikvisionRunAt DateTime?
  lastCloudRunAt     DateTime?
  lastCloudError     String?
  updatedAt          DateTime  @updatedAt

  @@map("worker_state")
}

/// API event fields are persisted in separate columns, using the original
/// property names (and dotted paths for nested entities). Display-only values
/// are derived when reading.
model LogEvent {
  /// Internal identity used to deduplicate live and history copies.
  id       String @map("_event_id")
  deviceId String @map("_device_id")

  /// Fields from `/ISAPI/AccessControl/AcsEvent`.
  major             Json?
  minor             Json?
  time              Json?
  doorNo            Json?
  serialNo          Json?
  currentVerifyMode Json?
  mask              Json?
  cardNo            Json?
  cardType          Json?
  name              Json?
  cardReaderNo      Json?
  employeeNoString  Json?
  userType          Json?
  pictureURL        Json?
  faceRectHeight    Json? @map("FaceRect.height")
  faceRectWidth     Json? @map("FaceRect.width")
  faceRectX         Json? @map("FaceRect.x")
  faceRectY         Json? @map("FaceRect.y")

  /// Top-level fields from `/ISAPI/Event/notification/alertStream`.
  eventType        Json?
  dateTime         Json?
  eventState       Json?
  eventDescription Json?
  deviceID         Json?
  activePostCount  Json?
  ipAddress        Json?
  remoteHostAddr   Json?
  portNo           Json?
  protocol         Json?
  macAddress       Json?
  channelID        Json?

  /// Fields from the nested `AccessControllerEvent` entity.
  accessDeviceName          Json? @map("AccessControllerEvent.deviceName")
  accessMajorEventType      Json? @map("AccessControllerEvent.majorEventType")
  accessSubEventType        Json? @map("AccessControllerEvent.subEventType")
  accessCardNo              Json? @map("AccessControllerEvent.cardNo")
  accessCardType            Json? @map("AccessControllerEvent.cardType")
  accessName                Json? @map("AccessControllerEvent.name")
  accessCardReaderKind      Json? @map("AccessControllerEvent.cardReaderKind")
  accessCardReaderNo        Json? @map("AccessControllerEvent.cardReaderNo")
  accessDoorNo              Json? @map("AccessControllerEvent.doorNo")
  accessVerifyNo            Json? @map("AccessControllerEvent.verifyNo")
  accessEmployeeNoString    Json? @map("AccessControllerEvent.employeeNoString")
  accessSerialNo            Json? @map("AccessControllerEvent.serialNo")
  accessUserType            Json? @map("AccessControllerEvent.userType")
  accessCurrentVerifyMode   Json? @map("AccessControllerEvent.currentVerifyMode")
  accessCurrentEvent        Json? @map("AccessControllerEvent.currentEvent")
  accessFrontSerialNo       Json? @map("AccessControllerEvent.frontSerialNo")
  accessAttendanceStatus    Json? @map("AccessControllerEvent.attendanceStatus")
  accessLabel               Json? @map("AccessControllerEvent.label")
  accessStatusValue         Json? @map("AccessControllerEvent.statusValue")
  accessMask                Json? @map("AccessControllerEvent.mask")
  accessHelmet              Json? @map("AccessControllerEvent.helmet")
  accessPurePwdVerifyEnable Json? @map("AccessControllerEvent.purePwdVerifyEnable")

  /// Internal transport metadata, not a field from the API event.
  source String

  /// When we received this copy; used to order rows with missing event times.
  receivedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, id])
  @@index([deviceId, receivedAt])
}

/// Events containing person data, retained independently of devices and the
/// general access-event log.
model AttendanceLog {
  id           String    @id
  /// Terminal the event came from. Nullable and `SetNull` on delete so
  /// attendance survives removing a device, as it always has.
  deviceId     String?   @map("device_id")
  deviceIp     String?   @map("device_ip")
  deviceModel  String?   @map("device_model")
  deviceSerial String?   @map("device_serial")
  serialNo     BigInt?   @map("serial_no")
  personId     String?   @map("person_id")
  personName   String?   @map("person_name")
  cardNo       String?   @map("card_no")
  gateDirection String   @default("none") @map("gate_direction")
  dateTime     DateTime? @map("datetime")
  timeRaw      String?   @map("time_raw")

  /// Stable upstream identity for cloud deduplication and tenant scoping.
  eventType      String? @map("event_type")
  verification   String? @map("verification_mode")
  organizationId String  @default("default") @map("organization_id")

  /// Internal event identity prevents live-stream and history imports from
  /// storing the same terminal event twice.
  sourceKey String @unique @map("_source_key")

  device Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  outbox CloudSyncOutbox?

  @@index([dateTime])
  @@index([personId, dateTime])
  @@index([gateDirection, dateTime])
  @@index([organizationId, dateTime])
  @@map("attendance_logs")
}

/// Transactional outbox: one row per attendance event queued for the cloud.
/// The local database is the durable queue, so a disabled network, a crashed
/// worker, or a restarted server never loses an event — it stays `PENDING`
/// until the cloud accepts it.
model CloudSyncOutbox {
  id              String    @id
  attendanceLogId String    @unique @map("attendance_log_id")
  organizationId  String    @default("default") @map("organization_id")
  /// "PENDING" | "SYNCED" | "FAILED"
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  lastError       String?
  nextAttemptAt   DateTime  @default(now())
  syncedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attendanceLog AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("cloud_sync_outbox")
}

/// Master user records maintained by this application and synchronized to
/// each configured terminal. Date-time strings are local terminal times.
model User {
  id                 String   @id
  employeeNo         String   @unique
  name               String
  cardNo             String   @default("")
  cardNosJson        String   @default("[]")
  userType           String   @default("normal")
  floorNumber        Int      @default(0)
  roomNumber         Int      @default(0)
  gender             String   @default("unknown")
  longTermEffective  Boolean  @default(false)
  isAdministrator    Boolean  @default(false)
  visitTimes         Int      @default(0)
  authenticationType String   @default("sameDevice")
  authenticationMode String   @default("face")
  validFrom          String?
  validUntil         String?
  photoData          Bytes?
  photoMimeType      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  syncLogs UserSyncLog[]

  @@index([name])
}

/// Immutable record of each user sync attempt, including deleted users.
model UserSyncLog {
  id          String   @id
  userId      String?
  employeeNo  String
  userName    String
  deviceId    String?
  deviceLabel String
  operation   String
  status      String
  message     String?
  createdAt   DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([employeeNo, createdAt])
}
